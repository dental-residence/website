---json
{
  "layout": "layouts/base.njk",
  "title": "Which Appointment Should I Book? | Dental Residence",
  "ogTitle": "Which Appointment Should I Book?",
  "ogDescription": "A plain-English guide to every appointment you can book online at Dental Residence, Petersham.",
  "ogUrl": "https://www.dentalresidence.com.au/which-appointment.html",
  "bodyClass": "header-page  banner-plain  wsite-page-which-appointment  full-width-on  wsite-theme-light",
  "description": "Not sure which dental appointment to book? A plain-English guide to every appointment at Dental Residence, Petersham, with who you'll see and how long it takes.",
  "navActiveSub": "/which-appointment.html"
}
---
{#- Booking guide listing every MyHealth1st booking type, in menu order, from
    _data/bookingTypes.json. Names must match the booking menu word for word. -#}
				<div class="banner-wrap">
					<div class="wsite-elements wsite-not-footer wsite-header-elements">
	<div class="wsite-section-wrap">
	<div class="wsite-section wsite-header-section wsite-section-bg-image" style="vertical-align: middle;height: auto;background-color: #EFEAE1;">
		<div class="appt-hero">
			<div class="appt-hero__text">
				<h1 class="appt-hero__title">Which appointment should I book?</h1>
				<p class="appt-hero__intro">Choose the appointment that best matches why you're coming in. Not sure? <a href="tel:{{ site.phone }}" id="telephone_button_guide">Call us</a> and we'll help you choose.</p>
			</div>
			<div class="appt-hero__photo img-soon" role="img" aria-label="Photo coming soon"><svg viewBox="0 0 600 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false"><g transform="rotate(-14 300 300)"><polygon points="120,250 300,120 480,250" fill="#4A1824"/><rect x="120" y="250" width="360" height="230" fill="#521B28"/><rect x="148" y="150" width="304" height="240" fill="#F3EEE6"/><text x="300" y="232" text-anchor="middle" font-family="Oranienbaum, Georgia, serif" font-size="44" letter-spacing="3" fill="#4A1622">COMING SOON</text><line x1="262" y1="258" x2="338" y2="258" stroke="#B9A48F" stroke-width="1"/><polygon points="120,300 300,392 480,300 480,480 120,480" fill="#6A2535"/><polyline points="120,300 300,392 480,300" fill="none" stroke="#7E3244" stroke-width="1.5"/><circle cx="300" cy="420" r="24" fill="none" stroke="#3A0F1A" stroke-width="1.5"/><text x="300" y="429" text-anchor="middle" font-family="Oranienbaum, Georgia, serif" font-size="24" fill="#3A0F1A">DR</text></g></svg></div>
		</div>
		<div class="wsite-section-content">
						<div id="banner">
							<div id="banner-container">
				<div class="wsite-section-elements">
				</div>
			</div>
						</div>
		</div>
	</div>
</div>
</div>
				</div>

				<div id="content-wrapper">
					<div id="wsite-content" class="wsite-elements wsite-not-footer">
	<div class="wsite-section-wrap">
	<div class="wsite-section wsite-body-section">
		<div class="wsite-section-content">
						<div class="container">
			<div class="wsite-section-elements">
<div class="appt-guide">
	{#- Three groups by reason for visit. Every key in bookingTypes.json must
	    appear in exactly one group, or it drops off this page. -#}
	{%- set groups = [
	  { id: "in-pain", jump: "In pain?", title: "Something's wrong", line: "Pain, a broken tooth or a tooth that needs to come out. We'll see you fast.", keys: ["emergency", "filling", "extraction", "root-canal"] },
	  { id: "check-ups", jump: "Check-ups", title: "Check-ups & cleans", line: "New here, coming back, or bringing the kids.", keys: ["new-patient", "returning", "child", "gum"] },
	  { id: "consultations", jump: "Consultations", title: "Consultations", line: "A chat first, before you decide anything.", keys: ["free-consult", "invisalign", "crown", "dentures", "consultation"] }
	] %}
	<nav class="appt-jump" aria-label="Appointment groups">
	{%- for g in groups %}<a href="#{{ g.id }}">{{ g.jump }}</a>{% endfor -%}
	</nav>
	{%- for g in groups %}
	<section class="appt-group" id="{{ g.id }}">
		<h2 class="appt-group__title">{{ g.title }}</h2>
		<p class="appt-group__line">{{ g.line }}</p>
		<ol class="appt-guide__list">
		{%- for key in g.keys %}{% set t = bookingTypes[key] %}
			<li class="appt-guide__item">
				<div class="appt-guide__text">
					<p class="appt-guide__name">{{ t.name }}</p>
					<p class="appt-guide__for">{{ t.for }}</p>
					{% if key == "new-patient" %}<p class="appt-guide__offer">Your first visit: full exam, scale &amp; clean, and x-rays for $249. Any further treatment is quoted before we start.</p>{% endif %}
					<p class="appt-guide__meta">{{ t.who }} &middot; {{ t.length }}{% if t.page %} &middot; <a href="{{ t.page }}">More about this</a>{% endif %}</p>
				</div>
				<div class="appt-guide__actions">
					<a href="{% if t.treatmentId %}{{ site.treatmentBookingUrl }}{{ t.treatmentId }}{% else %}{{ t.url }}{% endif %}" target="_blank" rel="noopener" class="appt-guide__btn" id="book_online_button_{{ key }}" data-booking-type="{{ key }}">Book</a>
					{% if t.rita %}<a href="{{ site.ritaBookingUrl }}" target="_blank" rel="noopener" class="appt-guide__rita" id="book_online_button_rita_{{ key }}" data-practitioner="rita-chen">or book with Rita</a>{% endif %}
				</div>
			</li>
		{%- endfor %}
		</ol>
	</section>
	{%- endfor %}
	{#- appointment-served.jpg licensed by the practice, 2026-10-24. -#}
	<section class="tx-feature appt-served">
		<figure class="tx-feature__img"><img src="/assets/img/appointment-served.jpg" alt="A white-gloved hand holding up a silver serving tray" width="675" height="1200" loading="lazy"></figure>
		<div class="tx-feature__text">
			<p class="tx-feature__kicker">At your service</p>
			<p class="tx-feature__line">Your appointment, served.</p>
			<p class="tx-feature__sub">Pick a time online in under a minute, or <a href="tel:{{ site.phone }}" id="telephone_button_guide_served">call us</a> and we'll take care of the rest.</p>
		</div>
	</section>
	<p class="appt-guide__note">Teeth whitening can't be booked online. Please <a href="tel:{{ site.phone }}" id="telephone_button_guide_whitening">call us</a>, or book a Complimentary Consultation - Cosmetic &amp; Implants.</p>
	<p class="appt-guide__note">We accept DVA, OHFFSS, Afterpay, Zip and humm, and offer interest-free payment plans.</p>
</div>
			</div>
		</div>
					</div>
	</div>
</div>
</div>
				</div>
