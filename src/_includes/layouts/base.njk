<!DOCTYPE html>
<html lang="en">
	<head>
		<title>{{ title | safe }}</title><meta property="og:site_name" content="Dental Residence" />
<meta property="og:title" content="{{ ogTitle }}" />
<meta property="og:description" content="{{ ogDescription }}" />
<meta property="og:url" content="{{ ogUrl }}" />
{% if noindex %}<meta name="robots" content="noindex" />
{% else %}<link rel="canonical" href="{{ site.url }}{{ '/' if page.url == '/index.html' else page.url }}" />
{% endif %}
{% if description %}<meta name="description" content="{{ description }}" />
{% endif %}{% if keywords %}<meta name="keywords" content="{{ keywords }}" />
{% endif %}<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="preconnect" href="https://www.googletagmanager.com">
{% for l in headLinks %}    {{ l | safe }}
{% endfor %}
		<meta property="og:image" content="{{ site.url }}/files/theme/images/socialshare.png" />

{% include "partials/tracking-head.njk" %}
{% if adsConversion %}
<!-- Event snippet for Thank You Page conversion page -->
<script>
  gtag('event', 'conversion', {'send_to': 'AW-357358707/l6F3CKeX89YCEPO4s6oB'});
</script>
{% endif %}
{% for block in jsonld %}<script type="application/ld+json">{{ block | safe }}</script>
{% endfor %}
		<link id="wsite-base-style" rel="stylesheet" type="text/css" href="/assets/css/vendor/sites.css" />
<link rel="stylesheet" type="text/css" href="/assets/css/vendor/social-icons.css" media="screen,projection" />
<link rel="stylesheet" type="text/css" href="/files/main_style.css" title="wsite-theme-css" />
<link rel="preload" href="/assets/fonts/Didact_Gothic/regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/Libre_Franklin/regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/Montserrat/regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/GFS_Didot/regular.woff2" as="font" type="font/woff2" crossorigin>
{% include "partials/fonts.njk" %}
{# Families used by platform-element font classes (playfair-display, lato,
   oxygen). The old Weebly site loaded them via a 39-family Google Fonts
   request inside every platform element; we load just the used ones. #}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Oxygen:wght@400;700&display=swap" rel="stylesheet">
{% include "partials/head-styles.njk" %}
<link rel="stylesheet" type="text/css" href="/assets/css/platform-elements.css" />
<link rel="stylesheet" type="text/css" href="/assets/css/site.css" />
	</head>
	<body class="{{ bodyClass }}"><div class="body-wrap">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TSWZZVL9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

		<div id="header">
		<div>
			<div class="nav-trigger hamburger">
				<div class="open-btn">
					<span class="mobile"></span>
					<span class="mobile"></span>
					<span class="mobile"></span>
				</div>
			</div>
                <div id="sitename"><a href="/"><img class="logo-image" src="/files/theme/images/dental_residence_logo.png" alt="Dental Residence — Marrickville Dentist"></a> </div>
			</div>


		</div>
		<div id="wrapper">
			<div class="bg-wrapper">
				{% import "partials/nav.njk" as navmenu %}<div id="navigation">{{ navmenu.menu(nav, navActive, navActiveSub) }}</div>
{{ content | safe }}
<div id="footer"{% if 'no-header' not in bodyClass %} style="background-color: #FFFFFF"{% endif %}>
				{% include "partials/footer-content.njk" %}
		<div class="navmobile-wrapper">
			<div id="navmobile" class="nav">{{ navmenu.menu(nav, navActive, navActiveSub) }}</div>
		</div>
	</div>

<div style='display:none'><span id="wsite-title">Dental Residence</span></div>

<script src="/assets/js/nav.js"></script>
		<script async type='text/javascript' src='https://www.myhealth1st.com.au/mh1-widget/2021/popup.v3.js'></script>

	</body>
</html>
