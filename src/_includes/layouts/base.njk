<!DOCTYPE html>
<html lang="en">
	<head>
		<title>{{ title | safe }}</title><meta property="og:site_name" content="Dental Residence" />
<meta property="og:title" content="{{ ogTitle }}" />
<meta property="og:description" content="{{ ogDescription }}" />
<meta property="og:url" content="{{ ogUrl }}" />
{% if noindex %}<meta name="robots" content="noindex" />
{% else %}<link rel="canonical" href="{{ site.url }}{{ canonical if canonical else ('/' if page.url == '/index.html' else page.url) }}" />
{% endif %}
{% if description %}<meta name="description" content="{{ description }}" />
{% endif %}{% if keywords %}<meta name="keywords" content="{{ keywords }}" />
{% endif %}<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="preconnect" href="https://www.googletagmanager.com">
{% for l in headLinks %}    {{ l | safe }}
{% endfor %}
		<meta property="og:image" content="{{ site.url }}/files/theme/images/socialshare.png" />

{% include "partials/tracking-head.njk" %}
{% if adsConversion %}
<!-- Event snippet for Thank You Page conversion page -->
<script>
  gtag('event', 'conversion', {'send_to': 'AW-357358707/l6F3CKeX89YCEPO4s6oB'});
</script>
{% endif %}
{% for block in jsonld %}<script type="application/ld+json">{{ block | safe }}</script>
{% endfor %}
		<link id="wsite-base-style" rel="stylesheet" type="text/css" href="/assets/css/vendor/sites.css" />
<link rel="stylesheet" type="text/css" href="/assets/css/vendor/social-icons.css" media="screen,projection" />
<link rel="stylesheet" type="text/css" href="/files/main_style.css?v={{ now.build }}" title="wsite-theme-css" />
{# Two faces sitewide (see "Typeface system" in site.css, which re-points the
   older family names at these files). #}
<link rel="preload" href="/assets/fonts/Montserrat/regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/Oranienbaum/regular.woff2" as="font" type="font/woff2" crossorigin>
{% include "partials/fonts.njk" %}
{% include "partials/head-styles.njk" %}
<link rel="stylesheet" type="text/css" href="/assets/css/platform-elements.css?v={{ now.build }}" />
<link rel="stylesheet" type="text/css" href="/assets/css/site.css?v={{ now.build }}" />
	</head>
	<body class="{{ bodyClass }}"><div class="body-wrap">
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TSWZZVL9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

		<div id="header">
		<div>
			<div class="nav-trigger hamburger">
				<div class="open-btn">
					<span class="mobile"></span>
					<span class="mobile"></span>
					<span class="mobile"></span>
				</div>
			</div>
                <div id="sitename"><a href="/"><img class="logo-image" width="4203" height="300" src="/files/theme/images/dental_residence_logo.png" alt="Dental Residence — Marrickville Dentist"></a> </div>
                <a class="header-book" href="/which-appointment.html" id="header_book_appointment">Book Appointment</a>
			</div>


		</div>
		<div id="wrapper">
			<div class="bg-wrapper">
				{% import "partials/nav.njk" as navmenu %}<div id="navigation">{{ navmenu.menu(nav, navActive, navActiveSub) }}</div>
{% if booking %}{% set bookingBox %}{% include "partials/booking-box.njk" %}{% endset %}{{ content | replace("<!-- booking-box -->", bookingBox) | safe }}{% else %}{{ content | safe }}{% endif %}
<div id="footer"{% if 'no-header' not in bodyClass %} style="background-color: #FFFFFF"{% endif %}>
				{% include "partials/footer-content.njk" %}
		<div class="navmobile-wrapper">
			<a class="navmobile-book" href="/which-appointment.html" id="navmobile_book_appointment">Book Appointment</a>
			<div id="navmobile" class="nav">{{ navmenu.menu(nav, navActive, navActiveSub) }}</div>
		</div>
	</div>

<div style='display:none'><span id="wsite-title">Dental Residence</span></div>

<script src="/assets/js/nav.js?v={{ now.build }}"></script>
{% if ytClips %}<script src="/assets/js/yt-clips.js?v={{ now.build }}" defer></script>{% endif %}
{% if videoClips %}<script src="/assets/js/video-clips.js?v={{ now.build }}" defer></script>{% endif %}
		<script async type='text/javascript' src='https://www.myhealth1st.com.au/mh1-widget/2021/popup.v3.js'></script>

	</body>
</html>
