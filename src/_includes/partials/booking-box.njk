{# "Book: <booking type>" panel for service pages. Rendered from the page's
   `booking` front matter (keys into _data/bookingTypes.json, names matching the
   MyHealth1st booking menu word for word) and spliced into the page body at the
   <!-- booking-box --> marker by base.njk, since page bodies are never
   template-processed.
   Book buttons deep-link to the type's MyHealth1st treatmentId. They must stay
   plain anchors: the 1stAvailableWidget class would let the widget script
   hijack them back to the generic practice widget. The book_online_button id
   prefix is what GTM's click trigger matches. Treatment links list dentists
   only, so types Rita (OHT) also does get a separate practitioner link.
   A type with no treatmentId yet falls back to its `url`.
   Pages that can't be booked online set bookingCall (a call button shown
   first) and bookingAltLabel (a heading over the booking types). #}
{%- set ritaFlags %}{% for key in booking %}{% if bookingTypes[key].rita %}y{% endif %}{% endfor %}{% endset -%}
<div class="booking-box">
	<p class="booking-box__eyebrow">{{ bookingLabel or "Booking your appointment" }}</p>
	{% if bookingIntro %}<p class="booking-box__intro">{{ bookingIntro | safe }}</p>{% endif %}
	{% if bookingCall %}<a href="tel:{{ site.phone }}" class="booking-box__btn booking-box__call" id="telephone_button_booking_call">{{ bookingCall }}</a>{% endif %}
	{% if bookingAltLabel %}<p class="booking-box__label booking-box__alt">{{ bookingAltLabel }}</p>{% endif %}
	<div class="booking-box__types">
	{%- for key in booking %}
		<div class="booking-box__type">
			<p class="booking-box__name">{{ bookingTypes[key].name }}</p>
			<p class="booking-box__meta">{{ bookingTypes[key].who }} &middot; {{ bookingTypes[key].length }}</p>
			{% if key == "new-patient" %}<p class="booking-box__offer">Your first visit: full exam, scale &amp; clean, and x-rays for $249. Any further treatment is quoted before we start.</p>
			{% elif bookingTypes[key].expect.length %}<p class="booking-box__label">What to expect</p>
			<ul class="booking-box__expect">{% for e in bookingTypes[key].expect %}<li>{{ e }}</li>{% endfor %}</ul>{% endif %}
			<a href="{% if bookingTypes[key].treatmentId %}{{ site.treatmentBookingUrl }}{{ bookingTypes[key].treatmentId }}{% else %}{{ bookingTypes[key].url }}{% endif %}" target="_blank" rel="noopener" class="booking-box__btn" id="book_online_button_{{ key }}" data-booking-type="{{ key }}">Book: {{ bookingTypes[key].name }}</a>
		</div>
	{%- endfor %}
	</div>
	{#- Matched dentist (front matter bookingDentist: anna | mac; optional
	    bookingDentistLine overrides the line). Deep-links that dentist's
	    availability for the first booking type. Plain anchor, see above. -#}
	{%- if bookingDentist and dentists[bookingDentist] -%}
	{%- set d = dentists[bookingDentist] -%}
	{%- set firstType = bookingTypes[booking[0]] -%}
	<div class="booking-box__pick">
		<img class="booking-box__pick-photo team-photo" src="{{ d.img }}" alt="{{ d.name }}" width="96" height="120" loading="lazy">
		<div>
			<p class="booking-box__pick-line">{{ bookingDentistLine or d.line }}</p>
			<a href="https://www.myhealth1st.com.au/appointmentWidget/?practiceId=9023&amp;practitionerId={{ d.practitionerId }}{% if firstType.treatmentId %}&amp;treatmentId={{ firstType.treatmentId }}{% endif %}" target="_blank" rel="noopener" class="booking-box__pick-link" id="book_online_button_pick_{{ bookingDentist }}" data-practitioner="{{ bookingDentist }}">Book with {{ d.short }}</a>
		</div>
	</div>
	{%- endif %}
	{%- if ritaFlags | trim %}
	<p class="booking-box__help">Seeing our Oral Health Therapist, Rita Chen? <a href="{{ site.ritaBookingUrl }}" target="_blank" rel="noopener" class="book-with-rita" id="book_online_button_rita" data-practitioner="rita-chen">Book with Rita</a></p>
	{%- endif %}
	<p class="booking-box__help">Not sure which to choose? <a href="/which-appointment.html">See which appointment to book</a>, or <a href="tel:{{ site.phone }}" id="telephone_button_booking">call us</a>.</p>
</div>
